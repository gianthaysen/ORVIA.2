# ORVIA Garmin-Worker — Umgebungsvariablen (Beispiel, KEINE echten Werte eintragen und committen)

# Supabase-Projekt-URL, z.B. https://abcdefgh.supabase.co (Pflicht)
SUPABASE_URL=

# Supabase service_role-Key (Pflicht, NIEMALS in Client/Repo/Logs)
SUPABASE_SERVICE_ROLE_KEY=

# Fernet-Schlüssel für Token-Verschlüsselung (Pflicht).
# Generieren: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Version des aktiven Fernet-Keys (für spätere Key-Rotation; Default 1)
TOKEN_ENCRYPTION_KEY_VERSION=1

# Optional: alte Keys für Entschlüsselung nach Rotation,
# Format "version:key,version:key" (z.B. "1:abc...=,2:def...=")
TOKEN_ENCRYPTION_LEGACY_KEYS=

# Sync-Intervall des Schedulers in Minuten (Default 30)
SYNC_INTERVAL_MINUTES=30

# Backfill-Zeitraum in Tagen beim Erstsync (Default 30)
SYNC_BACKFILL_DAYS=30

# Fallback-Zeitzone, wenn user_profiles.timezone fehlt (Default Europe/Vienna)
DEFAULT_TIMEZONE=Europe/Vienna

# Erlaubte CORS-Origins, kommasepariert (z.B. https://<user>.github.io)
ALLOWED_ORIGINS=

# HTTP-Port des Workers (Default 8000; Railway setzt PORT selbst)
PORT=8000

# Log-Level: DEBUG | INFO | WARNING | ERROR (Default INFO)
LOG_LEVEL=INFO
