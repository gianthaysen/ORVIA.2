# ============================================================
# ORVIA · Root-.gitignore
# ============================================================

# macOS
.DS_Store

# Abhängigkeiten (werden aus package.json / requirements.txt wiederhergestellt)
node_modules/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Persönliche Daten — gehören nicht ins Repo (auch nicht in ein privates)
orvia-strava-import.json

# Session-Arbeitsverzeichnisse (Batch 2d): Inhalte geleert, Löschung nur manuell
# möglich (Cowork-Bridge darf nicht unlinken) — bis dahin aus dem Git-Status raus.
_claude_session_tmp/
_to_delete/

# Sicherheitsnetz: echte Secrets niemals committen
# (app/env.js ist bewusst NICHT gelistet — enthält nur den öffentlichen anon key)
.env
.env.*
!.env.example

# Sync-Archive und Sitzungs-Zwischenstaende (reproduzierbar, gehoeren nicht ins Repo)
orvia_app_sync*.tgz
_gm62_dev/
sync17/
Upload-ORVIA.2-*/
.g1g_sw_blob_tmp.js
orvia_app_sync*/

# Auslieferungs- und Prüfpakete (reproduzierbar aus dem Arbeitsbaum, v8-342)
orvia-v8-*.tar.gz
orvia-v8-*.tgz
gw-stage.tar.gz
gw-probe-stage.tar.gz
_to_delete*
UPLOAD-github-*/
